# URL publica de la app. En staging/produccion debe ser HTTPS y coincidir con
# la URL configurada en BotFather para la MiniApp/WebApp.
# Local: http://localhost:3000
# Staging/produccion: https://tu-proyecto.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase. Service role debe quedarse siempre en servidor; nunca la expongas
# con prefijo NEXT_PUBLIC_.
SUPABASE_URL="https://replace-with-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace_with_supabase_service_role_key"

# Telegram bot y VIP Guard operativo.
TELEGRAM_BOT_TOKEN="replace_with_telegram_bot_token"
# Secret usado por Telegram al llamar /api/telegram/webhook en el header
# x-telegram-bot-api-secret-token. Usa solo A-Z, a-z, 0-9, _ y -, minimo 16.
TELEGRAM_WEBHOOK_SECRET="replace_with_webhook_secret"
# Chat ID del grupo VIP. Normalmente empieza por -100. Se comprueba desde
# /admin/vip-guard/settings y debe coincidir con el grupo activo guardado.
TELEGRAM_GROUP_CHAT_ID="replace_with_group_chat_id"
# Chat ID privado/grupo donde llegan alertas admin de intereses del marketplace.
# No usa TELEGRAM_GROUP_CHAT_ID como fallback para evitar ruido en el VIP.
TELEGRAM_ADMIN_ALERT_CHAT_ID="replace_with_admin_alert_chat_id"

# Cron de expiraciones. Se usa como Bearer token en /api/cron/check-expired.
CRON_SECRET="replace_with_cron_secret"
# Opcional: limita cuantos registros procesa cada ejecucion del cron.
# CRON_BATCH_SIZE=50

# Admin dashboard.
ADMIN_PASSWORD="replace_with_strong_password"
SESSION_SECRET="replace_with_32_char_minimum_session_secret"

# Telegram Mini App initData. Allowed range: 60 to 10800 seconds.
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=7200

# Product flags. Mantener payment intents apagado en staging salvo prueba
# explicita de esa cola manual. Referidos queda apagado por defecto.
NEXT_PUBLIC_ENABLE_REFERRALS=false
NEXT_PUBLIC_ENABLE_PAYMENT_INTENTS=false
NEXT_PUBLIC_ENABLE_MARKETPLACE_FIXTURES=false
NEXT_PUBLIC_CREATOR_NAME="Nombre creadora"
NEXT_PUBLIC_PRODUCT_NAME="Mi VIP"
# Contacto publico de fallback si el grupo VIP aun no tiene admin_contact.
# Acepta @username, username o URL https.
NEXT_PUBLIC_ADMIN_CONTACT="@usuario_admin"

# Opcionales de diagnostico/desarrollo.
# APP_VERSION se muestra en /api/admin/health si no hay VERCEL_GIT_COMMIT_SHA.
# APP_VERSION="staging-001"
# NEXT_PUBLIC_ALLOW_REAL_TELEGRAM_LOCAL=1
# DEV_TELEGRAM_USER_ID=424242
# DEV_TELEGRAM_FIRST_NAME="Creator Dev"
# DEV_TELEGRAM_USERNAME="creator_dev"
# DEV_TELEGRAM_LANGUAGE=es
# DEV_TELEGRAM_START_PARAM=dev

# Solo para aplicar SQL desde tu maquina, no es variable runtime de Vercel:
# DATABASE_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres"
