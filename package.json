{
  "name": "webapptelegram-nina",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:integration:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "test:db": "supabase test db",
    "test:e2e:build": "E2E_TEST_MODE=1 NEXT_PUBLIC_ENABLE_PAYMENT_INTENTS=true NEXT_PUBLIC_ENABLE_REFERRALS=true next build",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:wait": "node --experimental-strip-types scripts/wait-local-supabase.mts",
    "supabase:lint": "supabase db lint --local --level error",
    "supabase:stop": "supabase stop",
    "supabase:clean": "supabase stop --no-backup",
    "db:performance": "docker exec -i supabase_db_webapptelegram-nina-local psql -X -U postgres -d postgres < scripts/performance-explain.sql",
    "verify:local:full": "bash scripts/verify-local-full.sh",
    "check:env": "node --experimental-strip-types scripts/check-env.mts",
    "dev:initdata": "node --experimental-strip-types scripts/dev-initdata.mts",
    "zip:clean": "bash scripts/zip-clean.sh",
    "zip:verify": "bash scripts/verify-clean-zip.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.108.2",
    "clsx": "2.1.1",
    "grammy": "1.44.0",
    "lucide-react": "0.468.0",
    "next": "15.5.19",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "autoprefixer": "10.5.2",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.19",
    "postcss": "8.5.15",
    "supabase": "2.109.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
